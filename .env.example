# Supabase > Connect > Transaction pooler (puerto 6543).
# Codificar caracteres especiales de la contraseña en la URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
DB_POOL_MAX=3
# Certificado CA de Supabase si lo requiere la conexión (saltos de línea como \n).
# DB_SSL_CA=
# DB_SSL=false se permite únicamente para PostgreSQL local de desarrollo.
# Opcionales: envío de boletines por Gmail.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Mientras tenga un valor, TODOS los boletines se envían solo a esta dirección.
BOLETINES_TEST_EMAIL=
